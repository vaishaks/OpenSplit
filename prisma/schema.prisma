generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupRole {
  OWNER
  MEMBER
}

enum GroupMemberStatus {
  ACTIVE
  INVITED
}

enum SplitType {
  EVEN
  CUSTOM
  PERCENTAGE
  SHARES
}

model User {
  id           String        @id @default(cuid())
  googleSub    String?       @unique
  email        String        @unique
  name         String?
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships  GroupMember[]
  createdGroups Group[]      @relation("GroupCreator")
  createdExpenses Expense[]  @relation("ExpenseCreator")
  createdSettlements Settlement[] @relation("SettlementCreator")
  createdInvites GroupInvite[] @relation("InviteCreator")
  auditLogs    AuditLog[]    @relation("AuditActor")
}

model Group {
  id              String        @id @default(cuid())
  name            String
  currencyCode    String
  createdByUserId String
  inviteCode      String        @unique
  isArchived      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  createdBy       User          @relation("GroupCreator", fields: [createdByUserId], references: [id])
  members         GroupMember[]
  expenses        Expense[]
  settlements     Settlement[]
  invites         GroupInvite[]
  auditLogs       AuditLog[]

  @@index([createdByUserId])
}

model GroupMember {
  id        String            @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole         @default(MEMBER)
  status    GroupMemberStatus @default(INVITED)
  joinedAt  DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  paidExpenses Expense[]      @relation("ExpensePayer")
  participantEntries ExpenseParticipant[]
  settlementsFrom Settlement[] @relation("SettlementFrom")
  settlementsTo Settlement[] @relation("SettlementTo")

  @@unique([groupId, userId])
  @@index([userId])
}

model Expense {
  id              String      @id @default(cuid())
  groupId         String
  title           String
  notes           String?
  amountCents     Int
  currencyCode    String
  paidByMemberId  String
  splitType       SplitType
  spentAt         DateTime
  createdByUserId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  group           Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidByMember    GroupMember @relation("ExpensePayer", fields: [paidByMemberId], references: [id])
  createdBy       User        @relation("ExpenseCreator", fields: [createdByUserId], references: [id])
  participants    ExpenseParticipant[]

  @@index([groupId, spentAt])
}

model ExpenseParticipant {
  id            String      @id @default(cuid())
  expenseId     String
  memberId      String
  amountCents   Int
  percentageBps Int?
  shareUnits    Int?

  expense       Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member        GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([expenseId, memberId])
  @@index([memberId])
}

model Settlement {
  id              String      @id @default(cuid())
  groupId         String
  fromMemberId    String
  toMemberId      String
  amountCents     Int
  note            String?
  paidAt          DateTime
  createdByUserId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  group           Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromMember      GroupMember @relation("SettlementFrom", fields: [fromMemberId], references: [id])
  toMember        GroupMember @relation("SettlementTo", fields: [toMemberId], references: [id])
  createdBy       User        @relation("SettlementCreator", fields: [createdByUserId], references: [id])

  @@index([groupId, paidAt])
}

model GroupInvite {
  id              String      @id @default(cuid())
  groupId         String
  email           String?
  token           String      @unique
  expiresAt       DateTime
  createdByUserId String
  acceptedAt      DateTime?
  createdAt       DateTime    @default(now())

  group           Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy       User        @relation("InviteCreator", fields: [createdByUserId], references: [id])

  @@index([groupId])
}

model AuditLog {
  id          String    @id @default(cuid())
  actorUserId String
  groupId     String
  entityType  String
  entityId    String
  action      String
  metadataJson Json?
  createdAt   DateTime  @default(now())

  actor       User      @relation("AuditActor", fields: [actorUserId], references: [id])
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}
